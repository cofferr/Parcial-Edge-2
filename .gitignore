# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Configuración local (IPs de cada sesión)
config/config.toml

# Credenciales del firmware
firmware/**/secrets.h

# Datos: crudos, procesados y grabaciones (contienen rostros) fuera de git
data/raw/*
data/processed/*
data/recordings/*
!data/**/.gitkeep

# Snapshots y rostros conocidos (contienen rostros)
snapshots/
data/snapshots/
rostros_conocidos/

# Cachés y sistema
.pytest_cache/
.ruff_cache/
.DS_Store

# Capturas sueltas de prueba en la raíz
/*.jpg
/*.bin
/c.jpg
/s.bin

# Informe: salidas de compilación
informe/*.pdf
informe/*.aux
informe/*.log
informe/*.toc
informe/*.out

# Estado de ejecución del panel (candado y pids de los hijos)
data/.panel.*
data/*.lock
data/control.json
